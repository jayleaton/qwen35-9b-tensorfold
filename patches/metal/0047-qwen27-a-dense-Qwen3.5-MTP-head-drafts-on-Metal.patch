+/// A Qwen3.5 checkpoint's own config.json, when it declares one MTP layer: the head reads its `mtp.*` tensors.
+fn parseMtp(top: std.json.ObjectMap) !Config {
+    try text(top, "model_type", "qwen3_5");
+    const o = if (top.get("text_config")) |v| try object(v) else top;
+    if (try integer(o, "mtp_num_hidden_layers") != 1) return error.BadDraftConfig;
+    if (o.get("mtp_use_dedicated_embeddings")) |v| if (v != .bool or v.bool) return error.BadDraftConfig;
+    if (o.get("attn_output_gate")) |v| if (v != .bool or !v.bool) return error.BadDraftConfig;
+    const rope = try object(o.get("rope_parameters") orelse return error.BadDraftConfig);
+    try text(rope, "rope_type", "default");
+    const head_dim = try integer(o, "head_dim");
+    const factor = try number(rope, "partial_rotary_factor");
+    const rotary_f = factor * @as(f64, @floatFromInt(head_dim));
+    if (rotary_f <= 0 or rotary_f != @round(rotary_f)) return error.BadDraftConfig;
+    const layers = try integer(o, "num_hidden_layers");
+    if (layers == 0) return error.BadDraftConfig;
+    var taps: [max_taps]u32 = @splat(0);
+    taps[0] = mtp_embedding_tap;
+    taps[1] = layers - 1;
+    const c = Config{ .kind = .mtp, .hidden = try integer(o, "hidden_size"), .intermediate = try integer(o, "intermediate_size"), .layers = 1, .vocab = try integer(o, "vocab_size"), .heads = try integer(o, "num_attention_heads"), .kv_heads = try integer(o, "num_key_value_heads"), .head_dim = head_dim, .target_layers = layers, .block = 16, .mask = 0, .window = mtp_window, .group = 16, .conv = 2, .rank = 0, .topk = 16, .eps = @floatCast(try number(o, "rms_norm_eps")), .theta = try number(rope, "rope_theta"), .taps = taps, .tap_count = 2, .rotary = @intFromFloat(rotary_f) };
+    try c.check();
+    return c;
+}
