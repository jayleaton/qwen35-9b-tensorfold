diff --git a/zig/src/families/qwen27/dflash/mtp.zig b/zig/src/families/qwen27/dflash/mtp.zig
new file mode 100644
index 00000000..41b80602
--- /dev/null
+++ b/zig/src/families/qwen27/dflash/mtp.zig
@@ -0,0 +1,316 @@
+//! Qwen3.5's MTP head as a chain drafter: one gated attention layer over the target's last state and the next token.
+const std = @import("std");
+const mtl = @import("metal");
+const core = @import("core");
+const cfg = @import("config.zig");
+const op = @import("operators.zig");
+const ck = @import("../checkpoint.zig");
+const backend_mod = @import("runtime_backend.zig");
+const selector = @import("selector.zig");
+const Backend = backend_mod.Backend;
+const Ref = backend_mod.Ref;
+const opts = mtl.ResourceOptions.shared | mtl.ResourceOptions.untracked;
+
+/// The head's norms, each folded from the checkpoint's zero-centred `1 + w` into one bf16 buffer.
+const norm_names = [_][]const u8{ "mtp.pre_fc_norm_embedding.weight", "mtp.pre_fc_norm_hidden.weight", "mtp.layers.0.input_layernorm.weight", "mtp.layers.0.post_attention_layernorm.weight", "mtp.layers.0.self_attn.q_norm.weight", "mtp.layers.0.self_attn.k_norm.weight", "mtp.norm.weight" };
+const Norm = enum { embedding, hidden, input, post, q, k, final };
+const linear_names = [_][]const u8{ "mtp.fc.weight", "mtp.layers.0.self_attn.q_proj.weight", "mtp.layers.0.self_attn.k_proj.weight", "mtp.layers.0.self_attn.v_proj.weight", "mtp.layers.0.self_attn.o_proj.weight", "mtp.layers.0.mlp.gate_proj.weight", "mtp.layers.0.mlp.up_proj.weight", "mtp.layers.0.mlp.down_proj.weight" };
+const Linear = enum { fc, q, k, v, o, gate, up, down };
+
+pub const Head = struct {
+    linears: [linear_names.len]ck.Tensor,
+    norms: mtl.Buffer,
+    norm_at: [norm_names.len]usize,
+    /// The target's own final norm (stored folded), which the target's head reads its last layer through.
+    target_norm: Ref,
+    /// A chain's rows: each row's keys and values, which later rows attend, and the newest row's normed output.
+    chain_k: mtl.Buffer,
+    chain_v: mtl.Buffer,
+    state: mtl.Buffer,
+
+    pub fn load(b: *Backend) !Head {
+        const c = b.config;
+        var h: Head = undefined;
+        const src = b.source();
+        for (&h.linears, linear_names) |*t, name| t.* = try src.getFn(src.ptr, name);
+        const expect = [_][2]u32{ .{ c.hidden, 2 * c.hidden }, .{ 2 * c.qWidth(), c.hidden }, .{ c.kvWidth(), c.hidden }, .{ c.kvWidth(), c.hidden }, .{ c.hidden, c.qWidth() }, .{ c.intermediate, c.hidden }, .{ c.intermediate, c.hidden }, .{ c.hidden, c.intermediate } };
+        for (h.linears, expect) |t, shape| if (t.rank != 2 or t.shape[0] != shape[0] or t.shape[1] != shape[1] or t.dtype != .bf16) return error.BadMtpHead;
+        var total: usize = 0;
+        for (norm_names, 0..) |name, i| {
+            const t = try b.checkpoint.get(name);
+            const want: usize = if (i == @backingInt(Norm.q) or i == @backingInt(Norm.k)) c.head_dim else c.hidden;
+            if (t.rank != 1 or t.shape[0] != want or t.dtype != .bf16) return error.BadMtpHead;
+            h.norm_at[i] = total;
+            total += want * 2;
+        }
+        h.norms = try b.target.device.buffer(total, opts);
+        errdefer h.norms.deinit();
+        for (norm_names, h.norm_at) |name, at| {
+            const t = try b.checkpoint.get(name);
+            const from = std.mem.bytesAsSlice(u16, t.buffer.contents()[t.offset..][0..t.bytes]);
+            const to = h.norms.slice(u16, total / 2)[at / 2 ..][0..from.len];
+            for (from, to) |w, *out| out.* = bf16(@as(f32, @bitCast(@as(u32, w) << 16)) + 1.0);
+        }
+        const prefix: []const u8 = if (b.target.checkpoint.has("language_model.model.norm.weight")) "language_model." else "";
+        var name_buf: [64]u8 = undefined;
+        const final = try b.target.checkpoint.get(try std.fmt.bufPrint(&name_buf, "{s}model.norm.weight", .{prefix}));
+        if (final.rank != 1 or final.shape[0] != c.hidden or final.dtype != .bf16) return error.BadMtpHead;
+        h.target_norm = .{ .buf = final.buffer, .off = final.offset };
+        const rows = cfg.mtp_max_depth + 1;
+        h.chain_k = try b.target.device.buffer(@as(usize, rows) * c.kvWidth() * 2, opts);
+        errdefer h.chain_k.deinit();
+        h.chain_v = try b.target.device.buffer(@as(usize, rows) * c.kvWidth() * 2, opts);
+        errdefer h.chain_v.deinit();
+        h.state = try b.target.device.buffer(@as(usize, c.hidden) * 2, opts);
+        return h;
+    }
+    pub fn deinit(h: *Head) void {
+        h.norms.deinit();
+        h.chain_k.deinit();
+        h.chain_v.deinit();
+        h.state.deinit();
+    }
+    fn normRef(h: *const Head, n: Norm) Ref {
+        return .{ .buf = h.norms, .off = h.norm_at[@backingInt(n)] };
+    }
+};
+
+fn bf16(x: f32) u16 {
+    const u: u32 = @bitCast(x);
+    if (std.math.isNan(x)) return @intCast((u >> 16) | 0x40);
+    return @intCast((u + 0x7FFF + ((u >> 16) & 1)) >> 16);
+}
+
+/// One frame's rows through the head up to their keys and values; `h` is the fc output (the layer's residual).
+const Rows = struct { h: op.View, a: op.View, k: op.View, v: op.View };
+
+fn rmsInto(b: *Backend, e: mtl.ComputeEncoder, x: Ref, x_stride: u32, gain: Ref, y: Ref, y_stride: u32, rows: u32, heads: u32, dim: u32) !void {
+    try b.primitives.norm(e, x, gain, y, .{ .rows = rows, .heads = heads, .dim = dim, .x_stride = x_stride, .y_stride = y_stride, .eps = b.config.eps });
+    e.barrier();
+}
+
+fn project(b: *Backend, epoch: u64, mode: op.Mode, x: op.View, w: ck.Tensor) !op.View {
+    const ops = b.ops();
+    return ops.vtable.project(ops.ptr, epoch, x, w, mode);
+}
+
+/// Rows at `positions`: input states (the target's final-normed last layer, or a chain's own output) and embeddings.
+fn kvRows(b: *Backend, h: *const Head, epoch: u64, mode: op.Mode, hidden: op.View, target_normed: bool, emb: op.View, positions: []const u64) !Rows {
+    const c = b.config;
+    const rows: u32 = @intCast(positions.len);
+    const cat = try b.frame.alloc(rows, 2 * c.hidden, .bf16);
+    const cat_ref = try b.frame.ref(cat);
+    var e = try b.encoder(epoch);
+    try rmsInto(b, e, try b.frame.ref(emb), emb.stride, h.normRef(.embedding), cat_ref, cat.stride, rows, 1, c.hidden);
+    var source = try b.frame.ref(hidden);
+    var source_stride = hidden.stride;
+    if (target_normed) {
+        const normed = try b.frame.alloc(rows, c.hidden, .bf16);
+        e = try b.encoder(epoch);
+        try rmsInto(b, e, source, source_stride, h.target_norm, try b.frame.ref(normed), normed.stride, rows, 1, c.hidden);
+        source = try b.frame.ref(normed);
+        source_stride = normed.stride;
+    }
+    e = try b.encoder(epoch);
+    try rmsInto(b, e, source, source_stride, h.normRef(.hidden), .{ .buf = cat_ref.buf, .off = cat_ref.off + @as(usize, c.hidden) * 2 }, cat.stride, rows, 1, c.hidden);
+    const x = try project(b, epoch, mode, cat, h.linears[@backingInt(Linear.fc)]);
+    const a = try b.frame.alloc(rows, c.hidden, .bf16);
+    e = try b.encoder(epoch);
+    try rmsInto(b, e, try b.frame.ref(x), x.stride, h.normRef(.input), try b.frame.ref(a), a.stride, rows, 1, c.hidden);
+    const kraw = try project(b, epoch, mode, a, h.linears[@backingInt(Linear.k)]);
+    const v = try project(b, epoch, mode, a, h.linears[@backingInt(Linear.v)]);
+    const k = try b.frame.alloc(rows, c.kvWidth(), .bf16);
+    e = try b.encoder(epoch);
+    try rmsInto(b, e, try b.frame.ref(kraw), kraw.stride, h.normRef(.k), try b.frame.ref(k), k.stride, rows, c.kv_heads, c.head_dim);
+    try rotate(b, epoch, k, c.kv_heads, positions);
+    return .{ .h = x, .a = a, .k = k, .v = v };
+}
+
+fn rotate(b: *Backend, epoch: u64, x: op.View, heads: u32, positions: []const u64) !void {
+    const c = b.config;
+    const p = try b.frame.alloc(@intCast(positions.len), 1, .u64);
+    const pr = try b.frame.ref(p);
+    const to: [*]u64 = @ptrCast(@alignCast(pr.buf.contents() + pr.off));
+    @memcpy(to[0..positions.len], positions);
+    const e = try b.encoder(epoch);
+    try b.primitives.headRope(e, try b.frame.ref(x), pr, .{ .rows = @intCast(positions.len), .heads = heads, .head_dim = c.head_dim, .rotary = c.rotary, .stride = x.stride, .theta = @floatCast(c.theta) });
+    e.barrier();
+}
+
+/// Committed rows [context.end, end): each row's state with its successor's embedding, whose keys the cache keeps.
+pub fn absorb(b: *Backend, h: *const Head, mode: op.Mode, ring: mtl.Buffer, context: *op.Context, end: u64) !void {
+    const c = b.config;
+    const window: u64 = c.window;
+    const stride = c.tapWidth();
+    const begin = end -| (window - 1);
+    if (context.end < begin) context.* = .{ .cache = context.cache, .begin = begin, .end = begin };
+    b.context = context.*;
+    const ops = b.ops();
+    while (context.end < end) {
+        const first = context.end;
+        const slot: u32 = @intCast(first % window);
+        // the hidden rows and their successors' embedding rows stay contiguous in the ring
+        const rows: u32 = if (slot + 1 == window) 1 else @intCast(@min(@min(end - first, 16), window - 1 - slot));
+        const next_slot: u32 = @intCast((first + 1) % window);
+        var positions: [16]u64 = undefined;
+        for (positions[0..rows], 0..) |*p, i| p.* = first + i;
+        const epoch = try ops.vtable.begin(ops.ptr);
+        defer ops.vtable.release(ops.ptr, epoch);
+        const hidden = try b.frame.add(.{ .buf = ring, .off = (@as(usize, slot) * stride + c.hidden) * 2 }, rows, c.hidden, stride, .bf16);
+        const emb = try b.frame.add(.{ .buf = ring, .off = @as(usize, next_slot) * stride * 2 }, rows, c.hidden, stride, .bf16);
+        const tx = try ops.vtable.context_begin(ops.ptr, context.*);
+        errdefer ops.vtable.context_abort(ops.ptr, tx);
+        const r = try kvRows(b, h, epoch, mode, hidden, true, emb, positions[0..rows]);
+        try ops.vtable.context_append(ops.ptr, tx, epoch, 0, r.k, r.v, positions[0..rows]);
+        const next = op.Context{ .cache = context.cache, .begin = @max(context.begin, (first + rows) -| (window - 1)), .end = first + rows };
+        try ops.vtable.context_commit(ops.ptr, tx, epoch, next);
+        context.* = next;
+    }
+}
+
+/// One query row against the context's cached keys and the chain's own rows [0, own).
+fn attendOne(b: *Backend, e: mtl.ComputeEncoder, context: op.Context, q: Ref, h: *const Head, own: u32, out: Ref) !void {
+    const c = b.config;
+    const width = c.kvWidth();
+    const context_rows: u32 = @intCast(context.end - context.begin);
+    const keys = context_rows + own;
+    const merged_k = try b.frame.alloc(keys, width, .bf16);
+    const merged_v = try b.frame.alloc(keys, width, .bf16);
+    const k = try b.frame.ref(merged_k);
+    const v = try b.frame.ref(merged_v);
+    if (context_rows > 0) {
+        const at: u32 = @intCast(context.begin % c.window);
+        const first = @min(context_rows, c.window - at);
+        for ([_]mtl.Buffer{ b.caches[0].keys, b.caches[0].values }, [_]Ref{ k, v }) |cache, to| {
+            try b.copy(e, .{ .buf = cache, .off = @as(usize, at) * width * 2 }, to, first, width);
+            if (first < context_rows) try b.copy(e, .{ .buf = cache }, .{ .buf = to.buf, .off = to.off + @as(usize, first) * width * 2 }, context_rows - first, width);
+        }
+    }
+    const off = @as(usize, context_rows) * width * 2;
+    try b.copy(e, .{ .buf = h.chain_k }, .{ .buf = k.buf, .off = k.off + off }, own, width);
+    try b.copy(e, .{ .buf = h.chain_v }, .{ .buf = v.buf, .off = v.off + off }, own, width);
+    const mask = try b.frame.alloc(1, keys, .u8);
+    const m = try b.frame.ref(mask);
+    @memset(m.buf.contents()[m.off..][0..keys], 1);
+    const scale = 1.0 / @sqrt(@as(f32, @floatFromInt(c.head_dim)));
+    const R = core.shared_attention.Ref;
+    const views = [_]R{ .{ .buf = q.buf, .off = q.off }, .{ .buf = k.buf, .off = k.off }, .{ .buf = v.buf, .off = v.off }, .{ .buf = m.buf, .off = m.off }, .{ .buf = out.buf, .off = out.off } };
+    if (keys > 1024) try b.attention.encodeSplit(e, 1, keys, keys, scale, views[0], views[1], views[2], views[3], views[4]) else try b.attention.encode(e, 1, keys, keys, scale, views[0], views[1], views[2], views[3], views[4]);
+    e.barrier();
+}
+
+/// One chain row at `position` (keys and values in chain row `index`): its draft and that draft's log-probability.
+fn chainRow(b: *Backend, h: *const Head, mode: op.Mode, context: op.Context, input: Ref, input_stride: u32, target_normed: bool, token: u32, position: u64, index: u32) !struct { token: u32, logp: f64 } {
+    const c = b.config;
+    const ops = b.ops();
+    const epoch = try ops.vtable.begin(ops.ptr);
+    defer ops.vtable.release(ops.ptr, epoch);
+    const hidden = try b.frame.add(input, 1, c.hidden, input_stride, .bf16);
+    const ids = [_]u32{token};
+    const emb = try ops.vtable.embed(ops.ptr, epoch, undefined, &ids);
+    const pos = [_]u64{position};
+    const r = try kvRows(b, h, epoch, mode, hidden, target_normed, emb, &pos);
+    var e = try b.encoder(epoch);
+    const width = c.kvWidth();
+    try b.copy(e, try b.frame.ref(r.k), .{ .buf = h.chain_k, .off = @as(usize, index) * width * 2 }, 1, width);
+    try b.copy(e, try b.frame.ref(r.v), .{ .buf = h.chain_v, .off = @as(usize, index) * width * 2 }, 1, width);
+    const qraw = try project(b, epoch, mode, r.a, h.linears[@backingInt(Linear.q)]);
+    // q_proj's rows hold [query, gate] a head: the query halves are normed into contiguous heads
+    const q = try b.frame.alloc(1, c.qWidth(), .bf16);
+    e = try b.encoder(epoch);
+    try rmsInto(b, e, try b.frame.ref(qraw), 2 * c.head_dim, h.normRef(.q), try b.frame.ref(q), c.head_dim, c.heads, 1, c.head_dim);
+    try rotate(b, epoch, q, c.heads, &pos);
+    const att = try b.frame.alloc(1, c.qWidth(), .bf16);
+    e = try b.encoder(epoch);
+    try attendOne(b, e, context, try b.frame.ref(q), h, index + 1, try b.frame.ref(att));
+    const gated = try b.frame.alloc(1, c.qWidth(), .bf16);
+    e = try b.encoder(epoch);
+    try b.primitives.sigmoidGate(e, try b.frame.ref(att), try b.frame.ref(qraw), try b.frame.ref(gated), .{ .rows = 1, .heads = c.heads, .head_dim = c.head_dim, .x_stride = att.stride, .gate_stride = qraw.stride, .y_stride = gated.stride });
+    e.barrier();
+    const o = try project(b, epoch, mode, gated, h.linears[@backingInt(Linear.o)]);
+    const h2 = try addRows(b, epoch, r.h, o);
+    const a2 = try b.frame.alloc(1, c.hidden, .bf16);
+    e = try b.encoder(epoch);
+    try rmsInto(b, e, try b.frame.ref(h2), h2.stride, h.normRef(.post), try b.frame.ref(a2), a2.stride, 1, 1, c.hidden);
+    const g = try project(b, epoch, mode, a2, h.linears[@backingInt(Linear.gate)]);
+    const u = try project(b, epoch, mode, a2, h.linears[@backingInt(Linear.up)]);
+    const s = try ops.vtable.swiglu(ops.ptr, epoch, g, u);
+    const d = try project(b, epoch, mode, s, h.linears[@backingInt(Linear.down)]);
+    const h3 = try addRows(b, epoch, h2, d);
+    const x = try b.frame.add(.{ .buf = h.state }, 1, c.hidden, c.hidden, .bf16);
+    e = try b.encoder(epoch);
+    try rmsInto(b, e, try b.frame.ref(h3), h3.stride, h.normRef(.final), try b.frame.ref(x), x.stride, 1, 1, c.hidden);
+    const head = try ops.vtable.head(ops.ptr, epoch, x);
+    const picked = try b.frame.alloc(1, @sizeOf(core.bf16_topk.Row), .u8);
+    const logits = try b.frame.ref(head.logits);
+    const out = try b.frame.ref(picked);
+    const params = core.bf16_topk.Params{ .rows = 1, .vocab = head.logits.width, .k = c.topk, .stride = head.logits.stride };
+    _ = try b.encoder(epoch);
+    try b.topk.encode(b.frame.encoder, .{ .buf = logits.buf, .off = logits.off }, .{ .buf = out.buf, .off = out.off }, params);
+    b.frame.encoder.barrier();
+    b.frame.finish() catch |err| {
+        b.failed = true;
+        return err;
+    };
+    const raw: *const core.bf16_topk.Row = @ptrCast(@alignCast(out.buf.contents() + out.off));
+    const entries = try core.bf16_topk.decode(raw, params);
+    if (entries.len == 0) return error.MtpNoCandidate;
+    // the head's top candidates stand in for its whole vocabulary in the draft's probability
+    var sum: f64 = 0;
+    for (entries) |en| sum += @exp(@as(f64, en.score) - entries[0].score);
+    const top = entries[0].token;
+    const id = if (head.token_ids) |t| blk: {
+        const tr = try b.frame.ref(t);
+        break :blk std.mem.readInt(u32, tr.buf.contents()[tr.off + @as(usize, top) * 4 ..][0..4], .little);
+    } else top;
+    return .{ .token = id, .logp = -@log(sum) };
+}
+
+fn addRows(b: *Backend, epoch: u64, x: op.View, r: op.View) !op.View {
+    const y = try b.frame.alloc(x.rows, x.width, .bf16);
+    const e = try b.encoder(epoch);
+    try b.primitives.add(e, try b.frame.ref(x), try b.frame.ref(r), try b.frame.ref(y), .{ .rows = x.rows, .width = x.width, .x_stride = x.stride, .r_stride = r.stride, .y_stride = y.stride });
+    e.barrier();
+    return y;
+}
+
+/// Up to `depth` drafts after `pending` from row end - 1, stopping once the chain probability falls under the cut.
+pub fn chain(gpa: std.mem.Allocator, b: *Backend, h: *const Head, mode: op.Mode, ring: mtl.Buffer, context: op.Context, end: u64, pending: u32, depth: u32) !selector.Tree {
+    const c = b.config;
+    const cap = @min(cfg.mtp_max_depth, try @import("sys").environment.read(u32, "TF_QWEN27_MTP_DEPTH", cfg.mtp_default_depth));
+    const n = @min(depth, cap);
+    const cut = @log(@max(try @import("sys").environment.read(f64, "TF_QWEN27_MTP_CONFIDENCE", cfg.mtp_default_confidence), std.math.floatMin(f64)));
+    var tree = selector.Tree{ .gpa = gpa, .tokens = try gpa.alloc(u32, n), .parents = &.{}, .scores = &.{} };
+    errdefer gpa.free(tree.tokens);
+    tree.parents = try gpa.alloc(i32, n);
+    errdefer gpa.free(tree.parents);
+    tree.scores = try gpa.alloc(f64, n);
+    errdefer gpa.free(tree.scores);
+    if (n == 0) return tree;
+    if (end == 0 or context.end + 1 != end) return error.BadDraftContext;
+    b.context = context;
+    const window: u64 = c.window;
+    const stride = c.tapWidth();
+    const last = end - 1;
+    var token = pending;
+    var total: f64 = 0;
+    var kept: usize = n;
+    for (0..n) |i| {
+        const step: u32 = @intCast(i);
+        const input: Ref = if (i == 0) .{ .buf = ring, .off = (@as(usize, @intCast(last % window)) * stride + c.hidden) * 2 } else .{ .buf = h.state };
+        const row = try chainRow(b, h, mode, context, input, if (i == 0) stride else c.hidden, i == 0, token, last + step, step);
+        total += row.logp;
+        tree.tokens[i] = row.token;
+        tree.parents[i] = @as(i32, @intCast(i)) - 1;
+        tree.scores[i] = total;
+        token = row.token;
+        if (total < cut) {
+            kept = i + 1;
+            break;
+        }
+    }
+    tree.tokens = try gpa.realloc(tree.tokens, kept);
+    tree.parents = try gpa.realloc(tree.parents, kept);
+    tree.scores = try gpa.realloc(tree.scores, kept);
+    return tree;
+}
