+//! The MTP adapter that exposes its model state through the shared drafter contract.
+const lanes = @import("lanes");
+const dr = lanes.drafter;
+const max_lanes = @import("cuda_mtp_types.zig").max_lanes;
+
+const prior = [_]f64{ 0.7, 0.55, 0.45, 0.4, 0.35, 0.3, 0.3 };
+
+pub fn Adapter(comptime Mtp: type) type {
+    return struct {
+        fn cast(p: *anyopaque) *Mtp {
+            return @ptrCast(@alignCast(p));
+        }
+
+        pub fn taps(p: *anyopaque) []const u32 {
+            return cast(p).taps();
+        }
+
+        pub fn facts(p: *anyopaque) dr.Facts {
+            const d = cast(p);
+            return .{ .limit_shared_drafts = true, .depth = d.depth, .step_ms = d.step_ms, .prior = &prior, .plain_guard = true, .batched = !d.trees, .stream_bytes = d.ringBytes() + 2 * d.e.g.hidden * 2 + max_lanes * 4, .trees = d.trees, .window_costs = d.costs[0..d.n_costs], .lane_costs = d.costs[0..d.n_costs] };
+        }
+    };
+}
