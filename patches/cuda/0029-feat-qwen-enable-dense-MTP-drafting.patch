diff --git a/zig/src/families/qwen3_5/cuda_mtp_draw.zig b/zig/src/families/qwen3_5/cuda_mtp_draw.zig
new file mode 100644
index 000000000..1acf1ccc5
--- /dev/null
+++ b/zig/src/families/qwen3_5/cuda_mtp_draw.zig
@@ -0,0 +1,153 @@
+//! Coupled keyed-Gumbel and greedy draft draws for Qwen CUDA MTP across solo, tree, and batched passes.
+const std = @import("std");
+const cuda = @import("cuda");
+const lanes = @import("lanes");
+const mtp = @import("cuda_mtp.zig");
+
+const Mtp = mtp.Mtp;
+const Rule = cuda.sample.Rule;
+const ranks = lanes.shape.ranks;
+const lp_top = lanes.draft_tree.lp_top;
+const lp_words = mtp.lp_words;
+
+/// One draft row's sampling rule and target verify position (1-based slot + 1, matching cuda_native.zig's verifyFn).
+pub const Spec = struct {
+    sampling: ?lanes.Sampling = null,
+    position: u64 = 0,
+};
+
+/// sample.cu's Rule when `s` samples (temperature > 0), or null when `s` decodes greedily.
+pub fn ruleOf(s: Spec) ?Rule {
+    return cuda.sample.ruleFor(s.sampling);
+}
+
+/// sample.cu keys row r at static_cast<unsigned>(meta[r] + 1); wrapping subtraction keeps every u64 position exact.
+pub fn metaOf(position: u64) c_int {
+    return @bitCast(@as(u32, @truncate(position -% 1)));
+}
+
+/// Projects `specs.len` hidden rows at `input` to `d.logits` and launches greedy or target-coupled draws into `d.tok`.
+pub fn launch(d: *Mtp, input: u64, specs: []const Spec, cands: bool) !void {
+    const rows = specs.len;
+    if (rows == 0) return;
+    const e = d.e;
+    try d.proj(e.head, input, d.logits, rows);
+    var any_sampled = false;
+    for (specs) |s| any_sampled = any_sampled or ruleOf(s) != null;
+    if (!any_sampled) {
+        const argmax_rows: usize = if (cands and d.trees) 1 else rows;
+        try e.run(e.fns.argmax, .{ argmax_rows, 1, 1 }, .{ 1024, 1, 1 }, .{ d.logits, @as(c_int, @intCast(e.g.vocab)), d.tok });
+        if (cands and d.trees) try e.draws.logprobRows(e.stream, d.logits, e.g.vocab, d.picks, ranks, false, d.words, rows);
+        return;
+    }
+    const st = d.staged.bytes;
+    const rules = std.mem.bytesAsSlice(Rule, st[Mtp.rules_at..][0 .. rows * @sizeOf(Rule)]);
+    const meta = std.mem.bytesAsSlice(c_int, st[Mtp.meta_at..][0 .. rows * 4]);
+    for (specs, 0..) |s, i| {
+        rules[i] = ruleOf(s) orelse std.mem.zeroes(Rule);
+        meta[i] = metaOf(s.position);
+    }
+    try cuda.copy_source.enqueue(e.d, d.rules, st[Mtp.rules_at..][0 .. rows * @sizeOf(Rule)], e.stream);
+    try cuda.copy_source.enqueue(e.d, d.meta, st[Mtp.meta_at..][0 .. rows * 4], e.stream);
+    const picks: ?u64 = if (e.picks != 0) e.picks else null;
+    var i: usize = 0; // contiguous runs of sampled or greedy rows share one kernel launch, as cuda_engine.zig does
+    while (i < rows) {
+        const sampled = ruleOf(specs[i]) != null;
+        var n: usize = 1;
+        while (i + n < rows and (ruleOf(specs[i + n]) != null) == sampled) n += 1;
+        if (sampled) {
+            try e.draws.drawRows(e.stream, d.logits + i * e.g.vocab * 2, e.g.vocab, d.rules + i * @sizeOf(Rule), d.meta + i * 4, d.tok + i * 4, n, picks);
+        } else {
+            try e.run(e.fns.argmax, .{ n, 1, 1 }, .{ 1024, 1, 1 }, .{ d.logits + i * e.g.vocab * 2, @as(c_int, @intCast(e.g.vocab)), d.tok + i * 4 });
+        }
+        i += n;
+    }
+    if (cands and d.trees) try e.draws.logprobRows(e.stream, d.logits, e.g.vocab, d.picks, lp_top, false, d.words, rows);
+}
+
+/// Reads back `d.tok` (and `d.words` for trees) with one sync, filling `out_toks` and tree `cands`.
+pub fn fetch(d: *Mtp, specs: []const Spec, out_toks: []u32, cands: [][ranks]u32) !void {
+    const rows = specs.len;
+    if (rows == 0) return;
+    const e = d.e;
+    const st = d.staged.bytes;
+    try e.d.check(e.d.api.cuMemcpyDtoHAsync_v2(st.ptr + Mtp.tok_at, d.tok, rows * 4, e.stream.handle), "cuMemcpyDtoHAsync");
+    if (d.trees and cands.len > 0) try e.d.check(e.d.api.cuMemcpyDtoHAsync_v2(st.ptr + Mtp.words_at, d.words, cands.len * lp_words * 4, e.stream.handle), "cuMemcpyDtoHAsync");
+    try e.stream.synchronize();
+    const toks = std.mem.bytesAsSlice(u32, st[Mtp.tok_at..][0 .. rows * 4]);
+    for (out_toks, 0..) |*dst, i| dst.* = toks[i];
+    for (cands, 0..) |*c, r| {
+        if (!d.trees) {
+            c.* = @splat(toks[r]);
+            continue;
+        }
+        const w = std.mem.bytesAsSlice(u32, st[Mtp.words_at + r * lp_words * 4 ..][0 .. lp_words * 4]);
+        if (ruleOf(specs[r])) |rl| {
+            c.* = rankTreeRow(rl, @truncate(specs[r].position), toks[r], w);
+        } else {
+            for (c, 0..) |*t, j| t.* = w[2 + j];
+        }
+    }
+}
+
+/// Rank 0 is `picked`; runner-ups heuristically rank eligible `lp_top` candidates, repeating `picked` if short.
+pub fn rankTreeRow(rl: Rule, position: u32, picked: u32, w: []align(1) const u32) [ranks]u32 {
+    var out: [ranks]u32 = @splat(picked);
+    var v: [lp_top]f32 = undefined;
+    var n_valid: usize = 0;
+    while (n_valid < lp_top) : (n_valid += 1) {
+        if (w[2 + n_valid] == 0xFFFF_FFFF) break;
+        const logit: f32 = @bitCast(w[2 + lp_top + n_valid]);
+        if (!std.math.isFinite(logit)) break;
+        v[n_valid] = logit * rl.inv_t;
+    }
+    if (n_valid == 0) return out;
+    const m = v[0];
+    var keep: usize = if (rl.top_k == 0) n_valid else @min(n_valid, @as(usize, rl.top_k));
+    if (rl.top_p > 0.0 and rl.top_p < 1.0 and keep > 0) {
+        const denom_n: usize = if (rl.top_k != 0) keep else n_valid;
+        var norm: f32 = 0.0;
+        for (v[0..denom_n]) |x| norm += @exp(x - m);
+        var cum: f32 = 0.0;
+        for (v[0..keep], 0..) |x, j| {
+            cum += @exp(x - m) / norm;
+            if (cum >= rl.top_p) {
+                keep = j + 1;
+                break;
+            }
+        }
+    }
+    if (rl.min_log > -std.math.inf(f32)) {
+        const floor = m + rl.min_log;
+        var j: usize = 0;
+        while (j < keep and v[j] >= floor) j += 1;
+        keep = j;
+    }
+    const full = rl.top_k == 0 or rl.top_k > lanes.gpu_rule.candidates;
+    var scores: [lp_top]f32 = undefined;
+    var keys: [lp_top]u32 = undefined;
+    var taken: [lp_top]bool = @splat(false);
+    for (0..n_valid) |j| {
+        const id = w[2 + j];
+        taken[j] = id == picked;
+        const u = if (full) lanes.gpu_full.raceUniform(rl.seed, position, id) else lanes.gpu_rule.uniform24(rl.seed, position, id);
+        scores[j] = v[j] - @log(-@log(u));
+        keys[j] = lanes.gpu_rule.key(v[j]);
+    }
+    for (out[1..]) |*slot| {
+        var best: ?usize = null;
+        for (0..keep) |j| {
+            if (taken[j]) continue;
+            if (best) |b| {
+                const id_j = w[2 + j];
+                const id_b = w[2 + b];
+                if (scores[j] > scores[b] or (scores[j] == scores[b] and (keys[j] > keys[b] or (keys[j] == keys[b] and id_j < id_b)))) best = j;
+            } else best = j;
+        }
+        if (best) |b| {
+            slot.* = w[2 + b];
+            taken[b] = true;
+        }
+    }
+    return out;
+}
diff --git a/zig/src/families/qwen3_5/cuda_mtp_memory.zig b/zig/src/families/qwen3_5/cuda_mtp_memory.zig
new file mode 100644
index 000000000..5efca665c
--- /dev/null
+++ b/zig/src/families/qwen3_5/cuda_mtp_memory.zig
@@ -0,0 +1,46 @@
+//! Peak device-memory admission for loading and calibrating Qwen's CUDA MTP drafter.
+const std = @import("std");
+const geometry = @import("cuda_geometry.zig");
+const weights = @import("cuda_mtp_weights.zig");
+const types = @import("cuda_mtp_types.zig");
+
+pub const Room = struct { ctx: *anyopaque, read: *const fn (*anyopaque) ?u64 };
+
+pub fn check(gpa: std.mem.Allocator, io: std.Io, g: geometry.Geometry, dir: []const u8, scratch_bytes: usize, ring_bytes: usize, calibration_cache_bytes: usize, room: ?Room) !void {
+    const plan = try weights.allocationPlan(gpa, io, g, dir);
+    const peak = try peakBytes(plan.resident, plan.staging, scratch_bytes, ring_bytes, calibration_cache_bytes, g.hidden, types.max_lanes);
+    if (room) |r| {
+        const available = r.read(r.ctx) orelse return error.MtpBudgetUnavailable;
+        const need = std.math.cast(u64, peak) orelse return error.MtpMemorySizeOverflow;
+        if (need > available) {
+            std.log.err("qwen MTP startup needs {d:.2} GiB at its peak; {d:.2} GiB remains after the CUDA reserve", .{ @as(f64, @floatFromInt(need)) / (1 << 30), @as(f64, @floatFromInt(available)) / (1 << 30) });
+            return error.MtpDoesNotFit;
+        }
+    }
+}
+
+fn peakBytes(resident_weights: usize, staging_weights: usize, scratch: usize, ring: usize, calibration_cache: usize, hidden: usize, lanes: usize) !usize {
+    const hidden_bytes = std.math.mul(usize, hidden, 4) catch return error.MtpMemorySizeOverflow;
+    const held_bytes = std.math.mul(usize, lanes, 4) catch return error.MtpMemorySizeOverflow;
+    const ctx_hidden = std.math.add(usize, ring, hidden_bytes) catch return error.MtpMemorySizeOverflow;
+    const ctx_bytes = std.math.add(usize, ctx_hidden, held_bytes) catch return error.MtpMemorySizeOverflow;
+    const resident_state = std.math.add(usize, scratch, ctx_bytes) catch return error.MtpMemorySizeOverflow;
+    const resident_peak = std.math.add(usize, resident_weights, resident_state) catch return error.MtpMemorySizeOverflow;
+    const loading_peak = std.math.add(usize, resident_weights, staging_weights) catch return error.MtpMemorySizeOverflow;
+    // Calibration follows warm-up release: target cache coexists with MTP weights and scratch, not warm-up context.
+    const calibration_state = std.math.add(usize, scratch, calibration_cache) catch return error.MtpMemorySizeOverflow;
+    const calibration_peak = std.math.add(usize, resident_weights, calibration_state) catch return error.MtpMemorySizeOverflow;
+    return @max(@max(resident_peak, loading_peak), calibration_peak);
+}
+
+test "MTP startup peak counts resident state, conversion staging, and target calibration cache" {
+    try std.testing.expectEqual(@as(usize, 158), try peakBytes(100, 40, 20, 10, 30, 5, 2));
+    try std.testing.expectEqual(@as(usize, 300), try peakBytes(100, 200, 10, 10, 20, 1, 1));
+    try std.testing.expectEqual(@as(usize, 230), try peakBytes(100, 20, 10, 10, 120, 1, 1));
+}
+
+test "MTP startup peak rejects allocation-size overflow" {
+    try std.testing.expectError(error.MtpMemorySizeOverflow, peakBytes(std.math.maxInt(usize), 1, 0, 0, 0, 0, 0));
+    try std.testing.expectError(error.MtpMemorySizeOverflow, peakBytes(0, 0, 0, 0, 0, std.math.maxInt(usize), 1));
+    try std.testing.expectError(error.MtpMemorySizeOverflow, peakBytes(0, 0, 1, 0, std.math.maxInt(usize), 0, 0));
+}
diff --git a/zig/src/families/qwen3_5/cuda_mtp_prompt.zig b/zig/src/families/qwen3_5/cuda_mtp_prompt.zig
new file mode 100644
index 000000000..6e2dc7dcb
--- /dev/null
+++ b/zig/src/families/qwen3_5/cuda_mtp_prompt.zig
@@ -0,0 +1,52 @@
+const std = @import("std");
+
+pub const Mode = enum { normal, mtp, mtp_direct, none };
+
+pub const State = struct {
+    mode: Mode = .normal,
+    from: ?usize = null,
+    epoch: u64 = 0,
+
+    pub const TapConfig = struct { mode: Mode, from: ?usize };
+
+    pub fn setForPrompt(s: *State, from: ?usize, end: usize, direct: bool, taps: bool) TapConfig {
+        const previous: TapConfig = .{ .mode = s.mode, .from = s.from };
+        s.mode = if (from) |boundary|
+            (if (end <= boundary) .none else if (direct) .mtp_direct else .mtp)
+        else if (taps) (if (direct) .mtp_direct else .mtp) else .normal;
+        s.from = from;
+        return previous;
+    }
+
+    pub fn restoreTapConfig(s: *State, previous: TapConfig) void {
+        s.mode = previous.mode;
+        s.from = previous.from;
+    }
+
+    pub fn tapFrom(s: State, start: usize, rows: usize) ?usize {
+        const boundary = s.from orelse return null;
+        if (boundary <= start) return null;
+        const offset = boundary - start;
+        return if (offset < rows) offset else null;
+    }
+};
+
+test "MTP tap boundary is local only when it crosses a prompt chunk" {
+    const state: State = .{ .from = 4096 };
+    try std.testing.expectEqual(@as(?usize, null), state.tapFrom(0, 4096));
+    try std.testing.expectEqual(@as(?usize, null), state.tapFrom(4094, 2));
+    try std.testing.expectEqual(@as(?usize, 2), state.tapFrom(4094, 3));
+    try std.testing.expectEqual(@as(?usize, null), state.tapFrom(4096, 8));
+    try std.testing.expectEqual(@as(?usize, null), state.tapFrom(4094, 0));
+}
+
+test "prompt tap scope restores mode and boundary without rewinding target epoch" {
+    var state: State = .{ .epoch = 7 };
+    const previous = state.setForPrompt(4096, 4096, false, true);
+    try std.testing.expectEqual(Mode.none, state.mode);
+    state.epoch += 1;
+    state.restoreTapConfig(previous);
+    try std.testing.expectEqual(Mode.normal, state.mode);
+    try std.testing.expectEqual(@as(?usize, null), state.from);
+    try std.testing.expectEqual(@as(u64, 8), state.epoch);
+}
