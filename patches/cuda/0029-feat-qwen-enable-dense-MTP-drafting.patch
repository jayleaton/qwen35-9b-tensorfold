+    }
+    var w_row: [43]u32 = @splat(0xFFFF_FFFF);
+    w_row[0] = 0;
+    w_row[1] = 0;
+    const flat_logits = [_]f32{ 4.0, 3.99, 3.98, 3.97, 3.96, 3.95, 0.5, 0.4 };
+    for (flat_logits, 0..) |lv, j| {
+        w_row[2 + j] = @intCast(10 + j);
