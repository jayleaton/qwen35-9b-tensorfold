+fn kvOnlyRowsCheck(gpa: std.mem.Allocator, d: *Mtp, tap: u64, ids: []const u32, rows: usize) !bool {
+    const e = d.e;
+    const g = e.g;
+    const kw_bytes = d.kvWidth() * 2;
