+        concurrent_holds[i] = .{ .stream = &concurrent.streams[i], .pending = 0, .position = concurrent.ctxs[i].end + 1, .depth = 2, .lanes = shape };
+    }
+    d.batch = false;
+    try d.drafter().hold(&serial_holds);
