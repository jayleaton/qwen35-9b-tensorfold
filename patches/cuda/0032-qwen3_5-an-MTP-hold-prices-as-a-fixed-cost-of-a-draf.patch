diff --git a/zig/src/core/lanes/shared_price.zig b/zig/src/core/lanes/shared_price.zig
index 8483ea6c6..f2a80880b 100644
--- a/zig/src/core/lanes/shared_price.zig
+++ b/zig/src/core/lanes/shared_price.zig
@@ -12,7 +12,9 @@ const Bucket = struct {
     trials: u64 = 0, // completed all-plain trials, the first of them a warm-up
     plain: ?Point = null,
     draft: ?Point = null,
+    held: ?Moments = null, // Model.hold_fixed: every drafting round's extra rows and residual, a fit's moments
 };
+const Moments = struct { x: f64, y: f64, xx: f64, xy: f64 };
 pub const Price = struct { plain: f64, fixed: f64, row: f64 };
 
 pub const Prices = struct {
@@ -61,6 +63,19 @@ pub const Prices = struct {
         } else if (plain and rows == streams) {
             blend(&b.plain, point);
         } else if (rows > streams) blend(&b.draft, point);
+        const extra = point.rows - @as(f64, @floatFromInt(streams));
+        if (!plain and !trial and rows >= streams) moment(&b.held, extra, residual);
+    }
+
+    /// Model.hold_fixed: drafting rounds past the plain point, fit as a fixed hold plus a row slope of at least `row`.
+    pub fn priceFixed(p: *const Prices, streams: usize, sampled: bool, row: f64) ?Price {
+        const b = p.buckets.items[p.find(streams, sampled) orelse return null];
+        const plain = b.plain orelse return null;
+        const m = b.held orelse return .{ .plain = plain.residual, .fixed = plain.residual, .row = row };
+        const spread = m.xx - m.x * m.x; // extra rows' variance: below a row's square, the slope is not measured
+        const slope = if (spread >= 1) @max(row, (m.xy - m.x * m.y) / spread) else row;
+        const hold = @max(0, m.y - plain.residual - slope * m.x);
+        return .{ .plain = plain.residual, .fixed = plain.residual + hold, .row = slope };
     }
 
     /// Until a plain round is measured, leave the existing allocator and its draft ranking in charge.
@@ -75,6 +90,13 @@ pub const Prices = struct {
     }
 };
 
+fn moment(to: *?Moments, x: f64, y: f64) void {
+    const v: Moments = .{ .x = x, .y = y, .xx = x * x, .xy = x * y };
+    if (to.*) |*m| {
+        inline for (.{ "x", "y", "xx", "xy" }) |f| @field(m, f) += 0.1 * (@field(v, f) - @field(m, f));
+    } else to.* = v;
+}
+
 fn blend(to: *?Point, v: Point) void {
     if (to.*) |*old| {
         old.residual += 0.2 * (v.residual - old.residual);
diff --git a/zig/src/core/lanes/shared_price_test.zig b/zig/src/core/lanes/shared_price_test.zig
index 07c699164..4141f73ca 100644
--- a/zig/src/core/lanes/shared_price_test.zig
+++ b/zig/src/core/lanes/shared_price_test.zig
@@ -209,3 +209,27 @@ test "shared prices: only measured plain timing excludes a preceding deferred dr
         try t.expectEqual(@as(usize, 0), e.rule.shared_price.buckets.items.len - @intFromBool(independent));
     };
 }
+
+test "shared prices: hold_fixed fits drafting rounds as a fixed hold plus a row slope, never below the given row" {
+    var p: prices.Prices = .{};
+    defer p.deinit(a);
+    try t.expect(p.priceFixed(4, false, 0) == null);
+    try p.observe(a, 4, 4, 2, false, true, false);
+    try t.expectEqual(@as(f64, 2), p.priceFixed(4, false, 0.5).?.fixed); // no drafting round yet: no hold
+    try p.observe(a, 4, 8, 10, false, false, false); // one point: no spread, the given row's slope
+    const one = p.priceFixed(4, false, 0.5).?;
+    try t.expectEqual(@as(f64, 6), one.fixed - one.plain); // 10 - 2 - 0.5 x 4 extra rows
+    try t.expectEqual(@as(f64, 0.5), one.row);
+    // hold 6, then 1 ms a row: rounds with 0 and 8 extra rows, alternating, settle on that line
+    var q: prices.Prices = .{};
+    defer q.deinit(a);
+    try q.observe(a, 4, 4, 2, false, true, false);
+    for (0..200) |i| {
+        const extra: u64 = if (i % 2 == 0) 0 else 8;
+        try q.observe(a, 4, 4 + extra, 2 + 6 + @as(f64, @floatFromInt(extra)), false, false, false);
+    }
+    const v = q.priceFixed(4, false, 0).?;
+    try t.expectApproxEqAbs(@as(f64, 6), v.fixed - v.plain, 1e-6);
+    try t.expectApproxEqAbs(@as(f64, 1), v.row, 1e-6);
+    try t.expectApproxEqAbs(@as(f64, 1.75), q.price(4, false, 0).?.row, 1e-6); // without: the hold leans on the rows
+}
