index 8d7c793b9..5f6bb4323 100644
--- a/zig/src/core/lanes/depth.zig
+++ b/zig/src/core/lanes/depth.zig
@@ -58,6 +58,7 @@ pub const Rule = struct {
     granted_depth: bool = false, // node_probabilities: a stream drafts its last grant plus draft_slack, lone ones too
     confidence_floor: ?f64 = null,
     plain_streams: u32 = 0, // a shared round with this many streams or more drafts none (0: off; a family's switch)
+    hold_fixed: bool = false, // Model.hold_fixed: greedy shared prices fit a drafted round's excess as a fixed hold
     batch_rows: u32,
     batched_heads: bool = false, // one batch drafts every stream of a shared round (steps: the deepest stream's)
     row_cost: @import("row_cost.zig").RowCost = .{}, // what a row costs past shared_costs here, under k.learn_rows
@@ -390,7 +391,11 @@ pub const Rule = struct {
     /// Independent plain price and the row slope from a plain/drafted pair, at this exact count and mode.
     pub fn sharedPrice(r: *const Rule, streams: usize, sampled: bool) ?@import("shared_price.zig").Price {
         if (streams < 2 or !r.plain_guard or r.confidence_floor != null) return null;
-        var price = r.shared_price.price(streams, sampled, r.row_cost.extraMs(streams, sampled)) orelse return null;
+        const row = r.row_cost.extraMs(streams, sampled);
+        // sampled rounds keep the per-row price: their draws make a drafted row's own cost (mixed traffic drafted less)
+        const fixed = r.hold_fixed and !sampled;
+        const priced = if (fixed) r.shared_price.priceFixed(streams, sampled, row) else r.shared_price.price(streams, sampled, row);
+        var price = priced orelse return null;
         // The independent plain point owns the intercept; row learning owns the signed, noise-tested slope.
         if (r.k.learn_rows) price.row = r.row_cost.extraMs(streams, sampled);
         return price;
