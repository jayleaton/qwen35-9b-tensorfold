diff --git a/zig/src/core/lanes/shared_price.zig b/zig/src/core/lanes/shared_price.zig
index 8483ea6c6..6e7a7a691 100644
--- a/zig/src/core/lanes/shared_price.zig
+++ b/zig/src/core/lanes/shared_price.zig
@@ -3,6 +3,7 @@ const std = @import("std");
 const Allocator = std.mem.Allocator;
 pub const every: u64 = 64;
 pub const stale: u64 = 256;
+pub const min_spread: f64 = 4; // Model.hold_fixed: extra rows' variance (rows squared) that identifies a hold
 const Point = struct { residual: f64, rows: f64, at: u64 };
 const Bucket = struct {
     streams: usize,
@@ -12,7 +13,9 @@ const Bucket = struct {
     trials: u64 = 0, // completed all-plain trials, the first of them a warm-up
     plain: ?Point = null,
     draft: ?Point = null,
+    held: ?Moments = null, // Model.hold_fixed: every drafting round's extra rows and residual, a fit's moments
 };
+const Moments = struct { x: f64, y: f64, xx: f64, xy: f64 };
 pub const Price = struct { plain: f64, fixed: f64, row: f64 };
 
 pub const Prices = struct {
@@ -61,6 +64,20 @@ pub const Prices = struct {
         } else if (plain and rows == streams) {
             blend(&b.plain, point);
         } else if (rows > streams) blend(&b.draft, point);
+        const extra = point.rows - @as(f64, @floatFromInt(streams));
+        if (!plain and !trial and rows >= streams) moment(&b.held, extra, residual);
+    }
+
+    /// Model.hold_fixed: a fixed hold and a row slope (at least `row`) once drafting rounds' rows spread, else `price`
+    pub fn priceFixed(p: *const Prices, streams: usize, sampled: bool, row: f64) ?Price {
+        const b = p.buckets.items[p.find(streams, sampled) orelse return null];
+        const plain = b.plain orelse return null;
+        const m = b.held orelse return p.price(streams, sampled, row);
+        const spread = m.xx - m.x * m.x; // extra rows' variance
+        if (!(spread >= min_spread)) return p.price(streams, sampled, row);
+        const slope = @max(row, (m.xy - m.x * m.y) / spread);
+        const hold = @max(0, m.y - plain.residual - slope * m.x);
+        return .{ .plain = plain.residual, .fixed = plain.residual + hold, .row = slope };
     }
 
     /// Until a plain round is measured, leave the existing allocator and its draft ranking in charge.
@@ -75,6 +92,13 @@ pub const Prices = struct {
     }
 };
 
+fn moment(to: *?Moments, x: f64, y: f64) void {
+    const v: Moments = .{ .x = x, .y = y, .xx = x * x, .xy = x * y };
+    if (to.*) |*m| {
+        inline for (.{ "x", "y", "xx", "xy" }) |f| @field(m, f) += 0.1 * (@field(v, f) - @field(m, f));
+    } else to.* = v;
+}
+
 fn blend(to: *?Point, v: Point) void {
     if (to.*) |*old| {
         old.residual += 0.2 * (v.residual - old.residual);
diff --git a/zig/src/core/lanes/shared_price_test.zig b/zig/src/core/lanes/shared_price_test.zig
index 07c699164..6dd02aa2b 100644
--- a/zig/src/core/lanes/shared_price_test.zig
+++ b/zig/src/core/lanes/shared_price_test.zig
@@ -209,3 +209,53 @@ test "shared prices: only measured plain timing excludes a preceding deferred dr
         try t.expectEqual(@as(usize, 0), e.rule.shared_price.buckets.items.len - @intFromBool(independent));
     };
 }
+
+test "shared prices: hold_fixed fits drafting rounds as a fixed hold plus a row slope once their rows spread" {
+    var p: prices.Prices = .{};
+    defer p.deinit(a);
+    try t.expect(p.priceFixed(4, false, 0) == null);
+    try p.observe(a, 4, 4, 2, false, true, false);
+    try p.observe(a, 4, 8, 10, false, false, false); // one drafting round: no spread, the per-row price stands
+    const one = p.priceFixed(4, false, 0.5).?;
+    const old = p.price(4, false, 0.5).?;
+    try t.expectEqual(old.fixed, one.fixed);
+    try t.expectEqual(old.row, one.row);
+    // hold 6, then 1 ms a row: rounds with 0 and 8 extra rows, alternating, settle on that line
+    var q: prices.Prices = .{};
+    defer q.deinit(a);
+    try q.observe(a, 4, 4, 2, false, true, false);
+    for (0..200) |i| {
+        const extra: u64 = if (i % 2 == 0) 0 else 8;
+        try q.observe(a, 4, 4 + extra, 2 + 6 + @as(f64, @floatFromInt(extra)), false, false, false);
+    }
+    const v = q.priceFixed(4, false, 0).?;
+    try t.expectApproxEqAbs(@as(f64, 6), v.fixed - v.plain, 1e-6);
+    try t.expectApproxEqAbs(@as(f64, 1), v.row, 1e-6);
+    try t.expectApproxEqAbs(@as(f64, 1.75), q.price(4, false, 0).?.row, 1e-6); // without: the hold leans on the rows
+    // rounds whose extra rows barely move (0 and 1) do not identify a hold: the per-row price again
+    var r: prices.Prices = .{};
+    defer r.deinit(a);
+    try r.observe(a, 4, 4, 2, false, true, false);
+    for (0..200) |i| try r.observe(a, 4, 4 + @as(u64, i % 2), 9, false, false, false);
+    try t.expectEqual(r.price(4, false, 0).?.row, r.priceFixed(4, false, 0).?.row);
+}
+
+test "shared prices: hold_fixed reprices greedy rounds only; sampled rounds keep the per-row price" {
+    var table: @import("table.zig").Table = .{};
+    defer table.deinit(a);
+    for (1..17) |n| try table.put(a, @intCast(n), 10);
+    var r: @import("depth.zig").Rule = .{ .gpa = a, .prior = &.{0.8}, .most_drafts = 1, .family_costs = &table, .shared_costs = &table, .mtp_step_ms = 0, .plain_guard = true, .node_probabilities = false, .batch_rows = 16, .hold_fixed = true };
+    defer r.deinit();
+    for ([_]bool{ false, true }) |sampled| {
+        try r.observeShared(4, 4, 12, sampled, 0, true, false);
+        for (0..200) |i| {
+            const extra: u64 = if (i % 2 == 0) 0 else 8;
+            try r.observeShared(4, 4 + extra, 18 + @as(f64, @floatFromInt(extra)), sampled, 0, false, false);
+        }
+    }
+    const greedy = r.sharedPrice(4, false).?;
+    try t.expectApproxEqAbs(@as(f64, 6), greedy.fixed - greedy.plain, 1e-6); // the hold, fixed
+    const sampled = r.sharedPrice(4, true).?;
+    try t.expectEqual(sampled.plain, sampled.fixed); // per-row, as without hold_fixed
+    try t.expectApproxEqAbs(@as(f64, 1.75), sampled.row, 1e-6);
+}
